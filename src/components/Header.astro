---
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'All resources' },
  { href: '/further-maths/core-pure', label: 'Core Pure' },
  { href: '/further-maths/further-mechanics', label: 'Further Mechanics' },
  { href: '/tmua', label: 'TMUA' },
];
---
<header class="site-header">
  <div class="masthead">
    <a href="/" class="site-name">resources.danieljsmith.org</a>
    <div class="header-actions">
      <ThemeToggle />
      <a class="tuition-link" href="https://tuition.danieljsmith.org/contact">Tuition enquiries <span aria-hidden="true">&nearr;</span></a>
    </div>
  </div>
  <nav class="primary-nav" aria-label="Main navigation">
    <div class="nav-inner">
      {links.map(({ href, label }) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </div>
  </nav>
</header>
