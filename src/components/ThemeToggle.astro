---
interface Props {
  /** Icon only at every width (e.g. the source viewer's toolbar). */
  compact?: boolean;
  /** Render as an item in the document viewer's "More" menu. */
  menuItem?: boolean;
}
const { compact = false, menuItem = false } = Astro.props;
---
<button
  type="button"
  class:list={menuItem ? ['viewer-menu-item'] : ['theme-toggle', { 'theme-toggle--compact': compact }]}
  data-theme-toggle
  aria-label="Switch to dark mode"
  title="Switch to dark mode"
>
  {/* Icon and label swap in CSS from the root data-theme, so the server render is correct before JS runs. */}
  <svg class="when-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
  </svg>
  <svg class="when-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <span class:list={[{ 'theme-toggle-label': !menuItem }]} aria-hidden="true"><span class="when-light">Dark mode</span><span class="when-dark">Light mode</span></span>
</button>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  function syncButtons() {
    const dark = document.documentElement.dataset.theme === 'dark';
    const label = `Switch to ${dark ? 'light' : 'dark'} mode`;
    buttons.forEach(button => {
      button.setAttribute('aria-label', label);
      button.title = label;
    });
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#202225' : '#faf9f6');
  }
  buttons.forEach(button => button.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('resources-theme', theme); } catch { /* The toggle still works when storage is unavailable. */ }
    syncButtons();
  }));
  syncButtons();
</script>
