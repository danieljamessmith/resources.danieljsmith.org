---
import { EXAM_BOARDS, type ExamBoard } from '~/data/resources';

interface Props {
  variant?: 'sidebar' | 'mobile';
  boards?: { id: ExamBoard; label: string }[];
}

const { variant = 'sidebar', boards = EXAM_BOARDS } = Astro.props;

const filterItems = [
  { id: 'all' as const, label: 'All' },
  ...boards.map((b) => ({ id: b.id, label: b.label })),
];

const linkInactive =
  'block w-full text-left border-l-2 border-transparent pl-4 py-2 text-sm text-muted hover:border-rule hover:text-ink transition-colors duration-150';
---

{
  variant === 'sidebar' ? (
    <nav
      class="board-filter-sidebar hidden w-full shrink-0 lg:block"
      aria-label="Exam board filter"
      data-board-filter-nav="sidebar"
    >
      <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted">Exam Board</p>
      <ul class="space-y-1" role="list">
        {filterItems.map((item) => (
          <li>
            <button
              type="button"
              class={linkInactive}
              data-board-filter={item.id}
              data-board-filter-link="sidebar"
            >
              {item.label}
            </button>
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    <div class="mobile-selector">
      <label for="mobile-exam-board">Exam board</label>
      <select id="mobile-exam-board" data-board-select>
        {filterItems.map(item => <option value={item.id}>{item.id === 'all' ? 'All boards' : item.label}</option>)}
      </select>
    </div>
  )
}
