---
interface Props {
  id: string;
  title: string;
  /** Number of booklets listed; shown on the right of the heading. */
  count?: number;
}

const { id, title, count } = Astro.props;
/** Singular form of the count's label; pluralised when count !== 1. */
const countLabel = 'booklet';

const countText =
  count !== undefined && count > 0 ? `${count} ${countLabel}${count === 1 ? '' : 's'}` : null;
---

<section data-topic-section aria-labelledby={id}>
  <h2 id={id} class="topic-section-heading">
    <span class="topic-title">{title}</span>
    {countText && (
      <span class="topic-count" data-topic-count data-total={count} data-label={countLabel}>
        {countText}
      </span>
    )}
  </h2>
  <div>
    <slot />
  </div>
  <p class="topic-empty" data-topic-empty hidden>No booklets in this topic are tagged for this exam board yet.</p>
</section>
