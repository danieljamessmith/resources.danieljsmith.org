---
import BoardPills from '~/components/BoardPills.astro';
import {
  boardsToDataAttributeValue,
  getResourceBoards,
  type Resource,
} from '~/data/resources';

interface Props {
  note: Resource;
}

const { note } = Astro.props;
const boards = getResourceBoards(note);
const boardsAttr = boardsToDataAttributeValue(boards);
---

<article class="resource-row" data-boards={boardsAttr}>
  <div class="resource-main">
    <h3 class="resource-title">
      <a class="resource-link" href={`/view/${note.id}`}>{note.title}</a>
      <span class="notes-tag">Notes</span>
    </h3>
    <p class="resource-meta">
      <span>{note.description}</span>
      <BoardPills boards={boards} />
    </p>
  </div>
  <div class="resource-actions">
    <a class="resource-action" href={`/view/${note.id}`}>
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span>View notes<span class="sr-only">: {note.title}</span></span>
    </a>
  </div>
</article>
