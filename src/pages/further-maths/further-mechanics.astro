---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import TopicNav from '~/components/TopicNav.astro';
import BoardFilter from '~/components/BoardFilter.astro';
import TopicSection from '~/components/TopicSection.astro';
import ResourcePairCard from '~/components/ResourcePairCard.astro';
import { FM_MECH, FM_MECH_EXAM_BOARDS, getResourcePairs, type Resource } from '~/data/resources';

const mechTopics = [
  { id: 'miscellaneous-mechanics', label: 'Misc Mechanics' },
  { id: 'momentum-restitution-collisions', label: 'Momentum & Collisions' },
  { id: 'work-energy-power', label: 'Work, Energy and Power' },
  { id: 'centre-of-mass', label: 'Centre of Mass' },
];

function pairedOnly(
  list: ReturnType<typeof getResourcePairs>,
): { questions: Resource; solutions: Resource }[] {
  return list.filter(
    (p): p is { questions: Resource; solutions: Resource } => p.solutions !== undefined,
  );
}

const momentumPairs = pairedOnly(getResourcePairs(FM_MECH, 'Momentum & Collisions'));
const workEnergyPairs = pairedOnly(getResourcePairs(FM_MECH, 'Work, Energy and Power'));
const miscMechanicsPairs = pairedOnly(getResourcePairs(FM_MECH, 'Miscellaneous Mechanics'));
const centreOfMassPairs = pairedOnly(getResourcePairs(FM_MECH, 'Centre of Mass'));
---

<Layout
  title="Further Mechanics — A-level Further Maths Questions by Topic | resources.danieljsmith.org"
  description="Further Mechanics question-by-topic booklets for A-level Further Maths with full worked solutions."
>
  <div
    class="min-h-screen flex flex-col"
    data-board-storage-key="fm-mech-board-filter"
  >
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 w-full max-w-7xl mx-auto px-4 py-12 lg:px-6">
      <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10 xl:gap-12">
        <div class="hidden lg:flex lg:flex-col lg:gap-8 lg:w-52 lg:shrink-0 lg:sticky lg:top-8 lg:self-start">
          <BoardFilter variant="sidebar" boards={FM_MECH_EXAM_BOARDS} />
          <TopicNav variant="sidebar" topics={mechTopics} />
        </div>
        <div class="min-w-0">
          <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">All resources</a><span aria-hidden="true">/</span><a href="/#further-maths">Further Maths</a><span aria-hidden="true">/</span><span aria-current="page">Further Mechanics</span></nav>
          <p class="eyebrow">A-level Further Mathematics</p>
          <h1 class="page-title">Further Mechanics</h1>
          <p class="page-intro">Questions by topic with worked solutions. Select an exam board to highlight relevant booklets.</p>

          <div class="mobile-selectors">
            <BoardFilter variant="mobile" boards={FM_MECH_EXAM_BOARDS} />
            <TopicNav variant="mobile" topics={mechTopics} />
          </div>

          <TopicSection
            id="miscellaneous-mechanics"
            title="Miscellaneous Mechanics"
            count={miscMechanicsPairs.length}
          >
            {miscMechanicsPairs.length === 0 ? (
              <p class="text-sm text-muted italic px-1">Coming soon.</p>
            ) : (
              miscMechanicsPairs.map((pair) => <ResourcePairCard pair={pair} />)
            )}
          </TopicSection>

          <TopicSection
            id="momentum-restitution-collisions"
            title="Momentum & Collisions"
            count={momentumPairs.length}
          >
            {momentumPairs.length === 0 ? (
              <p class="text-sm text-muted italic px-1">Coming soon.</p>
            ) : (
              momentumPairs.map((pair) => <ResourcePairCard pair={pair} />)
            )}
          </TopicSection>

          <TopicSection
            id="work-energy-power"
            title="Work, Energy and Power"
            count={workEnergyPairs.length}
          >
            {workEnergyPairs.length === 0 ? (
              <p class="text-sm text-muted italic px-1">Coming soon.</p>
            ) : (
              workEnergyPairs.map((pair) => <ResourcePairCard pair={pair} />)
            )}
          </TopicSection>

          <TopicSection
            id="centre-of-mass"
            title="Centre of Mass"
            count={centreOfMassPairs.length}
          >
            {centreOfMassPairs.length === 0 ? (
              <p class="text-sm text-muted italic px-1">Coming soon.</p>
            ) : (
              centreOfMassPairs.map((pair) => <ResourcePairCard pair={pair} />)
            )}
          </TopicSection>

          <div class="h-[65vh] shrink-0" aria-hidden="true" />
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<script>
  import { initBoardFilter } from '~/scripts/board-filter';
  initBoardFilter();
</script>
