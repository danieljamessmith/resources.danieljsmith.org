---
import StrandPage from '~/components/StrandPage.astro';
import { FM_CP, getWorksheetCountByCategory } from '~/data/resources';
import { getStrand } from '~/data/topics';

const strand = getStrand(FM_CP)!;
const bookletCount = getWorksheetCountByCategory(FM_CP);
---

<StrandPage
  strand={strand}
  title="Further Maths Core Pure Exam-Style Questions by Topic"
  description={`Free exam-style A-level Further Maths Core Pure questions in ${bookletCount} booklets, with worked solutions and mark schemes. For Edexcel, AQA, OCR A, OCR MEI and CIE.`}
/>
