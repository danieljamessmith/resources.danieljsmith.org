---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
---
<Layout title="Page not found | resources.danieljsmith.org" description="This page could not be found.">
  <div class="min-h-screen flex flex-col">
    <Header />
    <main id="main-content" tabindex="-1" class="page-container home-main">
      <div class="home-intro">
        <p class="eyebrow">Error 404</p>
        <h1>Page not found</h1>
        <p>The resource may have moved or been renamed. Try one of these instead.</p>
      </div>
      <div class="home-directory">
        <div class="subject-list">
          <a class="subject-row" href="/further-maths/core-pure"><div><h2>Core Pure</h2><p>A-level Further Maths questions by topic.</p></div><span class="row-arrow" aria-hidden="true">&rarr;</span></a>
          <a class="subject-row" href="/further-maths/further-mechanics"><div><h2>Further Mechanics</h2><p>A-level Further Maths questions by topic.</p></div><span class="row-arrow" aria-hidden="true">&rarr;</span></a>
          <a class="subject-row" href="/tmua"><div><h2>TMUA</h2><p>Practice papers with answer keys.</p></div><span class="row-arrow" aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
