---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import {
  FM_OP,
  FM_CP,
  FM_MECH,
  esatHomeCount,
  getEsatStats,
  getWorksheetCountByCategory,
  isEsatShown,
} from '~/data/resources';
import { getShownStrands } from '~/data/topics';

// Each strand's line; a strand is listed only once it has a pack.
const lines: Record<string, string> = {
  [FM_CP]: 'Exam-style questions on the compulsory pure content, including complex numbers, vectors, differential equations and proof.',
  [FM_MECH]: 'Exam-style questions on the optional mechanics content, including collisions, work and energy, and centres of mass.',
  [FM_OP]: 'Exam-style questions on the optional pure content, including conic sections, number theory, groups and recurrence relations.',
};
const strands = getShownStrands().map(({ category, title, href }) => ({
  category,
  title,
  href,
  description: lines[category],
  count: getWorksheetCountByCategory(category),
}));
const tmuaPaperCount = getWorksheetCountByCategory('TMUA');
// ESAT is listed, and named in the search title and description, once it has a row.
const esatShown = isEsatShown();
const esatCount = esatHomeCount(getEsatStats());
const title = esatShown
  ? 'Free Further Maths, TMUA & ESAT Practice with Worked Solutions'
  : 'Free Further Maths & TMUA Practice with Worked Solutions';
const description = `Free exam-style Further Maths questions by topic, with worked solutions and mark schemes, and ${esatShown ? 'TMUA and ESAT' : 'TMUA'} practice papers. For Edexcel, AQA, OCR A, OCR MEI and CIE.`;
---
<Layout title={title} description={description}>
  <div class="min-h-screen flex flex-col">
    <Header />
    <main id="main-content" tabindex="-1" class="page-container home-main">
      <div class="home-intro">
        <h1>Mathematics resources</h1>
        <p class="home-lede">Free exam-style questions by topic and practice papers, with worked solutions and mark schemes.</p>
      </div>
      <div class="home-directory">
        <section id="further-maths" aria-labelledby="fm-heading">
          <div class="section-head">
            <h2 id="fm-heading" class="eyebrow">A-level Further Mathematics</h2>
            <p class="section-note">For Edexcel, AQA, OCR A, OCR MEI and CIE</p>
          </div>
          <div class="subject-list">
            {strands.map(strand => (
              <a class="subject-row" href={strand.href}>
                <div><h3>{strand.title}</h3><p>{strand.description}</p><span class="resource-count">{strand.count} question booklets, with mark schemes and worked solutions</span></div>
              </a>
            ))}
          </div>
        </section>
        <section aria-labelledby="admissions-heading">
          <h2 id="admissions-heading" class="eyebrow">Admissions tests</h2>
          <div class="subject-list">
            <a class="subject-row" href="/tmua/">
              <div><h3>TMUA</h3><p>Original practice papers in the style of the Test of Mathematics for University Admission, with answer keys and worked solutions.</p><span class="resource-count">{tmuaPaperCount} practice papers, with answer keys and worked solutions</span></div>
            </a>
            {esatShown && (
              <a class="subject-row" href="/esat/">
                <div><h3>ESAT</h3><p>Original practice papers in the style of the Engineering and Science Admissions Test, for Mathematics 1, Mathematics 2 and Physics.</p><span class="resource-count">{esatCount}</span></div>
              </a>
            )}
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
