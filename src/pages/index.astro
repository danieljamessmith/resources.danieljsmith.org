---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { FM_AP, FM_CP, FM_MECH, getWorksheetCountByCategory } from '~/data/resources';
import { getShownStrands } from '~/data/topics';

// Each strand's line; a strand is listed only once it has a pack.
const lines: Record<string, string> = {
  [FM_CP]: 'Exam-style questions on the compulsory pure content, including complex numbers, vectors, differential equations and proof.',
  [FM_MECH]: 'Exam-style questions on the optional mechanics content, including collisions, work and energy, and centres of mass.',
  [FM_AP]: 'Exam-style questions on the optional pure content, including conic sections, number theory, groups and recurrence relations.',
};
const strands = getShownStrands().map(({ category, title, href }) => ({
  category,
  title,
  href,
  description: lines[category],
  count: getWorksheetCountByCategory(category),
}));
const tmuaPaperCount = getWorksheetCountByCategory('TMUA');
---
<Layout title="Free Further Maths & TMUA Practice with Worked Solutions" description="Free exam-style Further Maths questions by topic, with worked solutions and mark schemes, and TMUA practice papers. For Edexcel, AQA, OCR A, OCR MEI and CIE.">
  <div class="min-h-screen flex flex-col">
    <Header />
    <main id="main-content" tabindex="-1" class="page-container home-main">
      <div class="home-intro">
        <p class="eyebrow">For students and teachers</p>
        <h1>Mathematics resources</h1>
        <p class="home-lede">Free exam-style questions by topic and practice papers, with worked solutions and mark schemes.</p>
      </div>
      <div class="home-directory">
        <section id="further-maths" aria-labelledby="fm-heading">
          <div class="section-head">
            <h2 id="fm-heading" class="eyebrow">A-level Further Mathematics</h2>
            <p class="section-note">For Edexcel, AQA, OCR A, OCR MEI and CIE</p>
          </div>
          <div class="subject-list">
            {strands.map(strand => (
              <a class="subject-row" href={strand.href}>
                <div><h3>{strand.title}</h3><p>{strand.description}</p><span class="resource-count">{strand.count} question booklets &middot; Mark schemes &middot; Worked solutions</span></div>
                <span class="row-arrow" aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
        </section>
        <section aria-labelledby="admissions-heading">
          <h2 id="admissions-heading" class="eyebrow">Admissions</h2>
          <div class="subject-list">
            <a class="subject-row" href="/tmua/">
              <div><h3>TMUA</h3><p>Original practice papers in the style of the Test of Mathematics for University Admission, with answer keys and worked solutions.</p><span class="resource-count">{tmuaPaperCount} practice papers &middot; Answer keys &middot; Worked solutions</span></div>
              <span class="row-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
