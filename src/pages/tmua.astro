---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { getResourcesByCategory, getPaperFamily, getTmuaStats, TMUA_SHARE_IMAGE } from '~/data/resources';
const tmuaPapers = getResourcesByCategory('TMUA')
  .filter(r => r.type === 'questions')
  .map(paper => ({ paper, ...getPaperFamily(paper) }));
const stats = getTmuaStats();
const solvedCopy =
  stats.solvedQuestions === 0 ? 'answer keys'
  : stats.solvedQuestions === stats.questions ? 'answer keys and step-by-step worked solutions for every question'
  : `answer keys and step-by-step worked solutions to ${stats.solvedQuestions} of them`;
const description = `${stats.questions} free TMUA-style questions in ${stats.sets} full practice sets (Paper 1 and Paper 2), with ${solvedCopy}.`;
---
<Layout title="Free TMUA Practice Papers with Worked Solutions" description={description} shareImage={TMUA_SHARE_IMAGE}>
  <div class="min-h-screen flex flex-col">
    <Header />
    <main id="main-content" tabindex="-1" class="page-container listing-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">All resources</a><span aria-hidden="true">/</span><span aria-current="page">TMUA</span></nav>
      <h1 class="page-title">TMUA practice papers and worked solutions</h1>
      <p class="page-intro">Original practice papers written in the style of the Test of Mathematics for University Admission.</p>
      <ul class="page-intro page-intro-list">
        <li>Each paper has 20 multiple-choice questions with an answer key. Questions are <strong>not in difficulty order</strong>, reflecting the post-2024 TMUA format.</li>
        <li>All papers are free to view and download. These papers are independent and are not affiliated with or endorsed by the organisations that set the TMUA.</li>
      </ul>
      <section class="tmua-list" aria-label="Practice papers">
        {tmuaPapers.map(({ paper, answers, solutions }) => (
          <div class="tmua-row">
            <div><h2><a class="tmua-row-link" href={`/view/${paper.id}/`}>{paper.title}</a></h2></div>
            <div class="tmua-row-actions">
              <span class="document-link" aria-hidden="true">View paper &rarr;</span>
              {answers && (
                <a class="document-link tmua-row-action" href={`/view/${answers.id}/`} ><span class="sr-only">{paper.title} </span>Answer key &rarr;</a>
              )}
              {solutions && (
                <a class="document-link tmua-row-action" href={`/view/${solutions.id}/`} ><span class="sr-only">{paper.title} </span>Worked solutions &rarr;</a>
              )}
            </div>
          </div>
        ))}
      </section>
    </main>
    <Footer />
  </div>
</Layout>
