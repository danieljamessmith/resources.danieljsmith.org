---
import '~/styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Free mathematics resources: practice papers, questions by topic and worked solutions.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <script is:inline>
      // Apply a saved choice before painting; new visitors always get light mode.
      try {
        if (localStorage.getItem('resources-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#202225');
        }
      } catch { /* Keep the light default when storage is unavailable. */ }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="53e68529-e7f5-4eb9-be5c-72d523f70d76"></script>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>

<script>
  // Keep the desktop document workflow; phones use the browser's Back button.
  const mobile = window.matchMedia('(max-width: 767px)');
  function syncResourceTargets() {
    document.querySelectorAll<HTMLAnchorElement>('a[data-mobile-same-tab]').forEach(link => {
      link.target = mobile.matches ? '_self' : '_blank';
    });
  }
  syncResourceTargets();
  mobile.addEventListener('change', syncResourceTargets);
</script>
